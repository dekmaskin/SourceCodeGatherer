<Window x:Class="SourceCodeGatherer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- File Filtering Tab -->
            <TabItem Header="File Filtering">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Excluded Directories -->
                    <Label Grid.Row="0" Content="Excluded Directories (one per line):" FontWeight="Bold"/>
                    <TextBox Grid.Row="1" Name="txtExcludedDirectories" 
                             AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding ExcludedDirectoriesText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,10"/>

                    <!-- Max File Size -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="Max File Size (MB):"/>
                        <TextBox Grid.Column="1" Name="txtMaxFileSize" Margin="5,0"
                                 Text="{Binding MaxFileSizeMB, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="2" Text="MB" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </Grid>

                    <!-- Use Streaming -->
                    <CheckBox Grid.Row="3" Content="Use streaming for large exports (recommended)" 
                              IsChecked="{Binding UseStreaming}"/>
                </Grid>
            </TabItem>

            <!-- Advanced Tab -->
            <TabItem Header="Advanced">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Advanced Settings" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Settings are automatically saved when you close this window." 
                                   Margin="0,0,0,10" FontStyle="Italic"/>
                        <TextBlock Text="Excluded directories support exact folder name matching (case-insensitive)." 
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Common exclusions: .git, .vs, .vscode, node_modules, bin, obj, packages" 
                                   Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="OK" Click="OkButton_Click" IsDefault="True"/>
            <Button Grid.Column="2" Content="Cancel" Click="CancelButton_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>