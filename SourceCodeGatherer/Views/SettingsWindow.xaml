<Window x:Class="SourceCodeGatherer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- File Filtering Lists Side by Side -->
                <Label Grid.Row="0" Content="File Filtering Settings:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Excluded Directories -->
                    <GroupBox Grid.Column="0" Header="Excluded Directories (one per line)">
                        <TextBox Name="txtExcludedDirectories" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ExcludedDirectoriesText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5"/>
                    </GroupBox>

                    <!-- Accepted File Formats -->
                    <GroupBox Grid.Column="2" Header="Accepted File Formats (one per line, include the dot)">
                        <TextBox Name="txtAcceptedFileFormats" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding AcceptedFileFormatsText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5"/>
                    </GroupBox>
                </Grid>

                <!-- Use Streaming -->
                <CheckBox Grid.Row="2" Content="Use streaming for large exports (recommended)" 
                          IsChecked="{Binding UseStreaming}" Margin="0,10,0,0"/>
            </Grid>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="OK" Click="OkButton_Click" IsDefault="True"/>
            <Button Grid.Column="2" Content="Cancel" Click="CancelButton_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>