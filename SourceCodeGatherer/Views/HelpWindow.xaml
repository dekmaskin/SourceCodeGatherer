<Window x:Class="SourceCodeGatherer.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage Guide" Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock Text="Source Code Gatherer - Usage Guide" FontWeight="Bold" FontSize="16" Margin="0,0,0,20"/>
                
                <TextBlock Text="Getting Started" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="1. Select a root directory containing your source code" Margin="10,0,0,5"/>
                <TextBlock Text="2. Choose which file types to include in the export" Margin="10,0,0,5"/>
                <TextBlock Text="3. Set the maximum file size limit using the slider" Margin="10,0,0,5"/>
                <TextBlock Text="4. Choose an output file location" Margin="10,0,0,5"/>
                <TextBlock Text="5. Click 'Export to File' or 'Export to Clipboard'" Margin="10,0,0,15"/>
                
                <TextBlock Text="File Filtering" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="• Excluded directories support exact folder name matching (case-insensitive)" Margin="10,0,0,5"/>
                <TextBlock Text="• Common exclusions: .git, .vs, .vscode, node_modules, bin, obj, packages" Margin="10,0,0,5"/>
                <TextBlock Text="• You can customize excluded directories in Settings" Margin="10,0,0,15"/>
                
                <TextBlock Text="File Formats" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="• Accepted file formats determine which files can be processed" Margin="10,0,0,5"/>
                <TextBlock Text="• Include the dot in extensions (e.g., .cs, .py, .js)" Margin="10,0,0,5"/>
                <TextBlock Text="• You can customize accepted file formats in Settings" Margin="10,0,0,5"/>
                <TextBlock Text="• Leave the accepted formats list empty to use default text file extensions" Margin="10,0,0,15"/>
                
                <TextBlock Text="File Size Limits" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="• Files larger than the limit will be skipped during export" Margin="10,0,0,5"/>
                <TextBlock Text="• Use the slider or enter values manually in KB" Margin="10,0,0,5"/>
                <TextBlock Text="• Range: 0 KB to 10 MB (10,240 KB)" Margin="10,0,0,15"/>
                
                <TextBlock Text="Export Options" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="• Export to File: Saves the gathered source code to a text file" Margin="10,0,0,5"/>
                <TextBlock Text="• Export to Clipboard: Copies the content directly to your clipboard" Margin="10,0,0,5"/>
                <TextBlock Text="• Streaming mode is automatically used for large exports (recommended)" Margin="10,0,0,15"/>
                
                <TextBlock Text="Tips" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="• Recent directories are saved for quick access" Margin="10,0,0,5"/>
                <TextBlock Text="• File type selections are remembered between sessions" Margin="10,0,0,5"/>
                <TextBlock Text="• Settings are automatically saved when you close the Settings window" Margin="10,0,0,5"/>
                <TextBlock Text="• You can drag and drop folders onto the main window" Margin="10,0,0,5"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Close Button -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Button Content="Close" Click="CloseButton_Click" IsDefault="True" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>